{
  "name": "mandala",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "mandala": "cli/mandala.mjs",
    "openmana": "cli/openmana.mjs"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "cli": "node cli/mandala.mjs",
    "task:start": "node scripts/task.mjs start",
    "task:check": "node scripts/task.mjs check",
    "review:screens": "node scripts/review-screens.mjs",
    "dev": "concurrently -k \"tsx watch scripts/dev-server.ts\" \"vite --host 127.0.0.1 --port 4174\"",
    "start": "tsx server/main.ts",
    "build": "node scripts/build-ssh-runner.mjs && vite build",
    "build:ssh-runner": "node scripts/build-ssh-runner.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "smoke:cli": "tsx scripts/cli-smoke.ts",
    "import:multica": "tsx scripts/import-multica.ts",
    "release:local": "tsx scripts/release-local.ts",
    "backup": "tsx scripts/workspace-backup.ts backup",
    "restore": "tsx scripts/workspace-backup.ts restore",
    "migrate:home": "tsx scripts/migrate-home.ts",
    "postinstall": "node scripts/prepare-terminal.mjs",
    "account:admin": "tsx scripts/account-admin.ts",
    "smoke:references": "node --import tsx scripts/reference-smoke.ts",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:start": "npm --prefix desktop start",
    "test:ui": "playwright test --config ui.playwright.config.ts",
    "release:check": "node scripts/check-release-source.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@colbymchenry/codegraph": "1.2.0",
    "@kutalia/whisper-node-addon": "1.1.0",
    "@tencentdb-agent-memory/tcvdb-text": "0.1.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "^0.5.0",
    "cross-spawn": "7.0.6",
    "dompurify": "^3.4.17",
    "highlight.js": "11.11.2",
    "ignore": "7.0.5",
    "lowlight": "3.3.0",
    "lucide-react": "^1.49.0",
    "mdast-util-from-markdown": "2.0.3",
    "mermaid": "11.17.2",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-cjk-friendly": "2.3.3",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "1.4.0",
    "tweetnacl": "1.0.3",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "22.20.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "concurrently": "10.0.6",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
